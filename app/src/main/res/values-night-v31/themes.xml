<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.NeriPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 拾光音乐新启动图（夜间同样用白色底+新 LOGO，与日间一致） -->
    <style name="Theme.NeriPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NeriPlayer</item>
    </style>
</resources>
