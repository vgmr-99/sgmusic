<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.NeriPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!--
      系统启动页只保留白底，图标用透明占位。
      与日间保持一致，真正的启动画面是应用内自绘的动态启动页。
    -->
    <style name="Theme.NeriPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_system_placeholder</item>
        <item name="postSplashScreenTheme">@style/Theme.NeriPlayer</item>
    </style>
</resources>
