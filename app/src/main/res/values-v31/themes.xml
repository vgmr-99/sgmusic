<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.NeriPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 拾光音乐新启动图：无极带 + 星光，参考 docs/assets/splash_preview.png -->
    <style name="Theme.NeriPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NeriPlayer</item>
    </style>
</resources>
